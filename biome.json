{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/.turbo",
      "!**/node_modules",
      "!**/__snapshots__",
      "!**/.next",
      "!**/out",
      "!**/.source",
      "!**/next-env.d.ts",
      "!.changeset",
      "!apps/demo/.claude",
      "!apps/demo/.mcp.json",
      "!apps/demo/design-tokens.json",
      "!apps/demo/design-tokens-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": {
        "noGlobalEval": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": []
          }
        }
      },
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "noParameterAssign": "error",
        "useConst": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/open-design-tokens/src/validator/**",
        "packages/open-design-tokens/src/core/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/linter/**", "**/linter"],
                    "message": "validator/core must not import from linter."
                  },
                  {
                    "group": ["node:*", "fs", "path", "os", "child_process"],
                    "message": "node builtins are only allowed in cli.ts and linter/node/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/open-design-tokens/src/linter/**",
        "!packages/open-design-tokens/src/linter/node/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "fs", "path", "os", "child_process"],
                    "message": "node builtins are only allowed in cli.ts and linter/node/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/open-design-tokens/src/cli.ts",
        "**/tests/**",
        "**/*.config.ts",
        "scripts/**",
        "apps/docs/scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/docs/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          },
          "correctness": {
            "noUnusedVariables": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/docs/app/global.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
